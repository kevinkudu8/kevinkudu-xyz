# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# but do commit the example
!.env.example

# third-party inspiration screenshots (kept local, not published)
/design/references/

# personal data exports (Letterboxd etc.) - never publish
/design/*.zip

# raw event media (originals are large; the site uses processed copies in public/events)
/design/Events Page/

# home photo originals (the site uses a cropped copy in src/assets)
/design/Home_image*
